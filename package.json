{
  "name": "cockpit",
  "productName": "Cockpit",
  "version": "0.1.0",
  "description": "Terminal visual para várias sessões de Claude/Codex por projeto",
  "private": true,
  "main": "out/main/index.js",
  "author": "Rodrigo Teixeira",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "build:mac": "sh scripts/install-mac.sh --no-install",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/darwin-*/spawn-helper",
    "install:mac": "sh scripts/install-mac.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "allotment": "^1.20.6",
    "dompurify": "^3.4.17",
    "marked": "^18.1.2",
    "node-pty": "^1.1.0",
    "openai": "^7.45.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
